{
  "name": "mcp-atlassian-integration",
  "version": "0.1.0",
  "description": "Minimal MCP-style HTTP server exposing Confluence and Jira read/write endpoints",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "docker-build": "docker build -t mcp-atlassian:latest .",
    "docker-run": "docker run --env-file .env -p 3000:3000 mcp-atlassian:latest"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "js-yaml": "^4.1.1",
    "nodemon": "^3.0.1"
  }
}
